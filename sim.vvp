#! /usr/bin/vvp
:ivl_version "10.3 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "system";
:vpi_module "vhdl_sys";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x573e290aa150 .scope module, "tb_divide_by_2" "tb_divide_by_2" 2 3;
 .timescale -9 -12;
v0x573e290e1780_0 .var "clk", 0 0;
v0x573e290e1850_0 .net "out", 0 0, v0x573e290e15a0_0;  1 drivers
v0x573e290e1920_0 .var "reset", 0 0;
E_0x573e290aa7c0 .event posedge, v0x573e290d1300_0;
S_0x573e290aa2f0 .scope module, "dut" "divide_by_2" 2 8, 3 6 0, S_0x573e290aa150;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk"
    .port_info 1 /INPUT 1 "reset"
    .port_info 2 /OUTPUT 1 "out"
v0x573e290d1300_0 .net "clk", 0 0, v0x573e290e1780_0;  1 drivers
v0x573e290e15a0_0 .var "out", 0 0;
v0x573e290e1660_0 .net "reset", 0 0, v0x573e290e1920_0;  1 drivers
E_0x573e290d1800 .event posedge, v0x573e290e1660_0, v0x573e290d1300_0;
    .scope S_0x573e290aa2f0;
T_0 ;
    %wait E_0x573e290d1800;
    %load/vec4 v0x573e290e1660_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x573e290e15a0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x573e290e15a0_0;
    %inv;
    %assign/vec4 v0x573e290e15a0_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x573e290aa150;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x573e290e1780_0, 0, 1;
T_1.0 ;
    %delay 5000, 0;
    %load/vec4 v0x573e290e1780_0;
    %inv;
    %store/vec4 v0x573e290e1780_0, 0, 1;
    %jmp T_1.0;
    %end;
    .thread T_1;
    .scope S_0x573e290aa150;
T_2 ;
    %vpi_call 2 22 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call 2 23 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x573e290aa150 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x573e290e1920_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x573e290e1920_0, 0, 1;
    %delay 120000, 0;
    %vpi_call 2 28 "$finish" {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x573e290aa150;
T_3 ;
    %wait E_0x573e290aa7c0;
    %vpi_call 2 33 "$display", "Time=%0t: clk rise, out=%b, reset=%b", $time, v0x573e290e1850_0, v0x573e290e1920_0 {0 0 0};
    %jmp T_3;
    .thread T_3;
