#! /usr/bin/vvp
:ivl_version "10.3 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "system";
:vpi_module "vhdl_sys";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x648ecaeb6f10 .scope module, "tb_divide_by_2" "tb_divide_by_2" 2 3;
 .timescale -9 -12;
v0x648ecaeccca0_0 .var "clk", 0 0;
v0x648ecaeccd70_0 .net "out", 0 0, v0x648ecaeccac0_0;  1 drivers
v0x648ecaecce40_0 .var "reset", 0 0;
E_0x648ecaeb7540 .event posedge, v0x648ecaeccac0_0;
E_0x648ecae81670 .event negedge, v0x648ecaeccac0_0;
E_0x648ecae81b10 .event posedge, v0x648ecae81110_0;
S_0x648ecaeb70d0 .scope module, "dut" "divide_by_2" 2 8, 3 6 0, S_0x648ecaeb6f10;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk"
    .port_info 1 /INPUT 1 "reset"
    .port_info 2 /OUTPUT 1 "out"
v0x648ecae81110_0 .net "clk", 0 0, v0x648ecaeccca0_0;  1 drivers
v0x648ecaeccac0_0 .var "out", 0 0;
v0x648ecaeccb80_0 .net "reset", 0 0, v0x648ecaecce40_0;  1 drivers
E_0x648ecae818b0 .event posedge, v0x648ecaeccb80_0, v0x648ecae81110_0;
    .scope S_0x648ecaeb70d0;
T_0 ;
    %wait E_0x648ecae818b0;
    %load/vec4 v0x648ecaeccb80_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x648ecaeccac0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x648ecaeccac0_0;
    %inv;
    %assign/vec4 v0x648ecaeccac0_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x648ecaeb6f10;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x648ecaeccca0_0, 0, 1;
T_1.0 ;
    %delay 5000, 0;
    %load/vec4 v0x648ecaeccca0_0;
    %inv;
    %store/vec4 v0x648ecaeccca0_0, 0, 1;
    %jmp T_1.0;
    %end;
    .thread T_1;
    .scope S_0x648ecaeb6f10;
T_2 ;
    %vpi_call 2 22 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call 2 23 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x648ecaeb6f10 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x648ecaecce40_0, 0, 1;
    %vpi_call 2 27 "$display", "=== DIVIDE BY 2 TEST ===" {0 0 0};
    %vpi_call 2 28 "$display", "Time=0: reset=1" {0 0 0};
    %delay 20000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x648ecaecce40_0, 0, 1;
    %vpi_call 2 31 "$display", "Time=20: reset=0, clock starts" {0 0 0};
    %delay 100000, 0;
    %vpi_call 2 34 "$display", "Time=120: Simulation finished" {0 0 0};
    %vpi_call 2 35 "$finish" {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x648ecaeb6f10;
T_3 ;
    %wait E_0x648ecae81b10;
    %load/vec4 v0x648ecaecce40_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_3.0, 8;
    %vpi_call 2 41 "$display", "Time=%0t: clk rise, out=%b", $time, v0x648ecaeccd70_0 {0 0 0};
T_3.0 ;
    %jmp T_3;
    .thread T_3;
    .scope S_0x648ecaeb6f10;
T_4 ;
    %wait E_0x648ecae81670;
    %vpi_call 2 45 "$display", "Time=%0t: out changed to %b", $time, v0x648ecaeccd70_0 {0 0 0};
    %jmp T_4;
    .thread T_4;
    .scope S_0x648ecaeb6f10;
T_5 ;
    %wait E_0x648ecaeb7540;
    %vpi_call 2 49 "$display", "Time=%0t: out changed to %b", $time, v0x648ecaeccd70_0 {0 0 0};
    %jmp T_5;
    .thread T_5;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
